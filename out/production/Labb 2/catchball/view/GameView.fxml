<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="720.0" prefWidth="960.0"
            xmlns="http://javafx.com/javafx/8.0.171"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="catchball.controller.GameController"
            style="-fx-background-color: linear-gradient(to bottom, #fffaf5, #ffe8d9);">
    <top>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="16.0" right="16.0" bottom="12.0" left="16.0"/>
            </padding>

            <Label text="Лови шарик" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #7a1f24;"/>
            <Label text="Одинарный клик по шарику даёт очки, двойной клик ставит игру на паузу. Промах обнуляет серию попаданий."
                   style="-fx-text-fill: #6d4c41; -fx-font-size: 13px;"/>

            <HBox alignment="CENTER_LEFT" spacing="14.0">
                <Label fx:id="scoreLabel" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #9a1f29;"/>
                <Label fx:id="comboLabel" style="-fx-font-size: 15px; -fx-text-fill: #a84d00;"/>
                <Label fx:id="statusLabel" style="-fx-font-size: 15px; -fx-text-fill: #37474f;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="speedLabel" style="-fx-font-size: 14px; -fx-text-fill: #455a64;"/>
                <Button fx:id="newGameButton" mnemonicParsing="false" onAction="#handleNewGame"
                        text="Новая игра"
                        style="-fx-background-color: #d9363e; -fx-text-fill: white; -fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <Pane fx:id="gamePane"
              prefWidth="800.0"
              prefHeight="560.0"
              onMouseClicked="#handlePaneClick"
              onMouseMoved="#handleMouseMoved"
              style="-fx-background-color: rgba(255,255,255,0.82); -fx-background-radius: 18; -fx-border-color: #f1b48c; -fx-border-radius: 18; -fx-border-width: 2;">
            <children>
                <Circle fx:id="ball" radius="30.0" onMouseClicked="#handleBallClick"/>
            </children>
            <BorderPane.margin>
                <Insets top="8.0" right="16.0" bottom="16.0" left="16.0"/>
            </BorderPane.margin>
        </Pane>
    </center>

    <bottom>
        <Label text="Бонусный вариант: за серию попаданий без промахов начисляются дополнительные очки. Каждые 3 точных попадания подряд увеличивают награду."
               style="-fx-padding: 0 16 16 16; -fx-text-fill: #6d4c41; -fx-font-size: 13px;"/>
    </bottom>
</BorderPane>
